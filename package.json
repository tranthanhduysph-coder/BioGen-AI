{
  "name": "ai-biology-question-generator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:exam-builder": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --jsx react-jsx --resolveJsonModule --esModuleInterop --skipLibCheck components/exam-builder/ExamBlueprintBuilder.tsx",
    "specification:ingest": "node scripts/ingest-biology-specification.mjs",
    "specification:check": "node scripts/ingest-biology-specification.mjs --check",
    "specification:audit": "node scripts/audit-content-competencies.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.12.0",
    "htmlparser2": "^12.0.0",
    "i18next": "^23.10.0",
    "katex": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "jszip": "^3.10.1"
  }
}
